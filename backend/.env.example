# ==============================================================
# FixNear India Backend Environment Variables Template
# ==============================================================

# Server Port
PORT=5000

# Environment (development | production)
NODE_ENV=production

# Frontend URL (For Strict CORS Whitelist)
# Example: https://fixnear.vercel.app or http://localhost:3000
FRONTEND_URL=https://fixnear.vercel.app

# JWT Authentication Secret
# Generate any long random string for production
JWT_SECRET=fixnear_super_secure_jwt_token_secret_key_india_2026

# Database Connection (Optional: PostgreSQL for Cloud Hosting)
# If left empty, SQLite (better-sqlite3) is automatically used.
# For Supabase / Neon / Render Postgres:
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/fixnear?sslmode=require

# Razorpay India Payment Gateway (Optional)
# If left empty, built-in UPI / Card Sandbox simulation is automatically used.
# Get your free test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary / S3 Media Storage (Optional)
# For storing uploaded verification licenses and work proof
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
